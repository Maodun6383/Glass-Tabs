{
  "name": "glass-tabs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview:png": "tsx scripts/preview.ts",
    "qr": "evenhub qr --http --port 5173",
    "pack": "npm run build && evenhub pack app.json dist -o glass-tabs.ehpk"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.9.0",
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@napi-rs/canvas": "^1.2.1",
    "@types/node": "^26.6.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
